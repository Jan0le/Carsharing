@model WebGUI.Models.Payments.PaymentPageViewModel

@{
    ViewData["Title"] = "Payments";
}

<div class="container mt-4">
    <h2 class="mb-3">💳 Payments</h2>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <div class="card mb-4">
        <div class="card-header">
            Create payment
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">ParticipantId</label>
                        <input class="form-control" name="ParticipantId" value="@(Model.ParticipantId?.ToString() ?? "")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input class="form-control" name="Amount" value="@(Model.Amount?.ToString() ?? "")" />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="ConfirmPayment" value="true" @(Model.ConfirmPayment ? "checked" : "") />
                            <label class="form-check-label">Confirm payment</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary" type="submit">Create</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Payment history</span>
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input class="form-control form-control-sm" style="max-width: 200px;" name="participantId" placeholder="participantId" value="@(Model.ParticipantId?.ToString() ?? "")" />
                <button class="btn btn-sm btn-outline-primary" type="submit">Load</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (Model.Payments is null || Model.Payments.Count == 0)
            {
                <div class="p-3 text-muted">No payments loaded.</div>
            }
            else
            {
                <table class="table table-striped mb-0">
                    <thead>
                    <tr>
                        <th>PaymentId</th>
                        <th>ParticipantId</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>CreatedAt (UTC)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Payments.OrderByDescending(x => x.CreatedAt))
                    {
                        <tr>
                            <td>@p.PaymentId</td>
                            <td>@p.ParticipantId</td>
                            <td>@p.Amount</td>
                            <td>@p.Status</td>
                            <td>@p.CreatedAt</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>



