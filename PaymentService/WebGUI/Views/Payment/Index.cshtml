@model WebGUI.Models.Payments.PaymentPageViewModel

@{
    ViewData["Title"] = "Payments";
}

<div class="container mt-4">
    <h2 class="mb-3">💳 Payments</h2>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <div class="card mb-4">
        <div class="card-header">
            💳 Neue Zahlung erstellen
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Teilnehmer-ID</label>
                        <input class="form-control" name="ParticipantId" type="number" min="1" value="@(Model.ParticipantId?.ToString() ?? "")" placeholder="z.B. 1, 2, 3..." required />
                        @if (Model.AvailableParticipantIds != null && Model.AvailableParticipantIds.Count > 0)
                        {
                            <small class="form-text text-muted">Verfügbare IDs: @string.Join(", ", Model.AvailableParticipantIds)</small>
                        }
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Betrag (€)</label>
                        <input class="form-control" name="Amount" type="number" step="0.01" min="0.01" value="@(Model.Amount?.ToString() ?? "")" placeholder="z.B. 12.50" required />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="ConfirmPayment" value="true" @(Model.ConfirmPayment ? "checked" : "") />
                            <label class="form-check-label">Zahlung bestätigen</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary" type="submit">Zahlung erstellen</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Zurücksetzen</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.AvailableParticipantIds != null && Model.AvailableParticipantIds.Count > 0)
    {
        <div class="alert alert-info mb-3">
            <strong>Verfügbare Teilnehmer:</strong> 
            @foreach (var id in Model.AvailableParticipantIds)
            {
                <a href="@Url.Action("Index", new { participantId = id })" class="badge bg-primary me-1">Teilnehmer #@id</a>
            }
            <span class="ms-2">(@Model.AvailableParticipantIds.Count Teilnehmer mit Zahlungen)</span>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Zahlungshistorie</span>
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input class="form-control form-control-sm" style="max-width: 200px;" name="participantId" placeholder="ParticipantId" value="@(Model.ParticipantId?.ToString() ?? "")" />
                <button class="btn btn-sm btn-outline-primary" type="submit">Laden</button>
            </form>
        </div>
        <div class="card-body p-0">
            @if (Model.Payments is null || Model.Payments.Count == 0)
            {
                <div class="p-3 text-muted">
                    @if (Model.ParticipantId.HasValue)
                    {
                        <text>Keine Zahlungen für Teilnehmer #@Model.ParticipantId gefunden.</text>
                    }
                    else
                    {
                        <text>Wählen Sie einen Teilnehmer aus, um die Zahlungshistorie anzuzeigen.</text>
                    }
                </div>
            }
            else
            {
                <table class="table table-striped mb-0">
                    <thead>
                    <tr>
                        <th>Zahlungs-ID</th>
                        <th>Teilnehmer-ID</th>
                        <th>Betrag</th>
                        <th>Status</th>
                        <th>Erstellt am (UTC)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Payments.OrderByDescending(x => x.CreatedAt))
                    {
                        <tr>
                            <td>@p.PaymentId</td>
                            <td>@p.ParticipantId</td>
                            <td>@p.Amount.ToString("C")</td>
                            <td>
                                @if (p.Status == "Completed")
                                {
                                    <span class="badge bg-success">@p.Status</span>
                                }
                                else if (p.Status == "Failed")
                                {
                                    <span class="badge bg-danger">@p.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@p.Status</span>
                                }
                            </td>
                            <td>@p.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>



